\newcommand{\ResumeHeavyRule}{\noalign{\hrule height 1pt}}
\newcommand{\CareerBlank}{&&\\\hline}
\newcommand{\ResumeSixBlanks}{\CareerBlank\CareerBlank\CareerBlank\CareerBlank\CareerBlank\CareerBlank}
\newcommand{\ResumeCareerBlanks}{\ResumeSixBlanks\ResumeSixBlanks}
\newcommand{\ResumeTableHead}[1]{%
  {\fontsize{8pt}{10pt}\selectfont 西暦}&{\fontsize{8pt}{10pt}\selectfont 月}&
  \multicolumn{1}{c!{\vrule width 1pt}}{\fontsize{8pt}{10pt}\selectfont #1}\\\hline}
\newenvironment{ResumeTable}[1]{%
  \begingroup
  \fontsize{11.5pt}{13pt}\selectfont
  % A 6.99mm strut plus the thin rule gives the reference's 7.13mm pitch.
  \renewcommand{\arraystretch}{1}
  \begin{longtable}{!{\vrule width 1pt}>{\centering\arraybackslash\rule[-2.25mm]{0pt}{6.99mm}}p{16mm}|>{\centering\arraybackslash}p{9mm}|>{\raggedright\arraybackslash}p{\dimexpr\textwidth-25mm-6\tabcolsep-2pt-2\arrayrulewidth\relax}!{\vrule width 1pt}}
  \ResumeHeavyRule\ResumeTableHead{#1}\endfirsthead
  \ResumeHeavyRule\ResumeTableHead{#1}\endhead
  \ResumeHeavyRule\endfoot
  \ResumeHeavyRule\endlastfoot
}{\end{longtable}\endgroup}
\newcommand{\ResumeCareerTable}{%
  \begin{ResumeTable}{学歴・職歴}
    &&\multicolumn{1}{c!{\vrule width 1pt}}{学歴}\\*\hline
    \ResumeEducationRows
    &&\multicolumn{1}{c!{\vrule width 1pt}}{職歴}\\*\hline
    \ResumeEmploymentRows
    &&\hfill 以上\\\hline
    % The default twelve blanks can be adjusted per document without changing the style.
    \ResumeCareerBlanks
  \end{ResumeTable}}
\newcommand{\ResumeQualificationTable}{%
  \begin{ResumeTable}{免許・資格}\ResumeQualificationRows\CareerBlank\CareerBlank\end{ResumeTable}}
