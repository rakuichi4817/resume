\newbox\ResumeTextBox
\newbox\ResumeTextPart
\newdimen\ResumeAvailable
\newdimen\ResumeBoxHeight
% Split paragraph material, not a minipage: even a single long paragraph may span pages.
\newcommand{\ResumeBox}[3][28mm]{%
  \par\begingroup
  \fontsize{11pt}{18pt}\selectfont
  \setbox\ResumeTextBox=\vbox{\hsize=\dimexpr\textwidth-10mm-2pt\relax
    \linewidth=\hsize\parindent=0pt\parskip=0pt\relax #3\par}%
  \loop
    \ResumeAvailable=\dimexpr\pagegoal-\pagetotal-1mm\relax
    \ifdim\ResumeAvailable>\textheight \ResumeAvailable=\textheight\fi
    \ifdim\ResumeAvailable<#1\relax \newpage\ResumeAvailable=\textheight\fi
    \ResumeBoxHeight=\dimexpr\ht\ResumeTextBox+\dp\ResumeTextBox+12mm\relax
    \ifdim\ResumeBoxHeight>\ResumeAvailable
      \splittopskip=\topskip\splitmaxdepth=0pt
      \setbox\ResumeTextPart=\vsplit\ResumeTextBox to \dimexpr\ResumeAvailable-12mm\relax
      \ResumeBoxHeight=\ResumeAvailable
    \else
      \setbox\ResumeTextPart=\box\ResumeTextBox
      \ifdim\ResumeBoxHeight<#1\relax \ResumeBoxHeight=#1\relax\fi
    \fi
    \noindent\vbox{\hrule height 1pt
      \hbox{\vrule width 1pt\vbox to \dimexpr\ResumeBoxHeight-2pt\relax{%
        \hsize=\dimexpr\textwidth-2pt\relax
        \vskip1mm\hbox to \hsize{\hskip1.5mm #2\hfil}\vskip1mm
        \hbox to \hsize{\hskip5mm\box\ResumeTextPart\hfil}\vfil
      }\vrule width 1pt}\hrule height 1pt}\par
    \ifvoid\ResumeTextBox\else\newpage\fi
  \unless\ifvoid\ResumeTextBox\repeat
  \endgroup}

\newcommand{\makeResume}{%
  \ResumeHeader
  \vspace{6.8mm}\ResumeCareerTable
  \vspace{6.8mm}\ResumeQualificationTable
  \vspace{6.8mm}\ResumeFamily
  \vspace{6.8mm}\ResumeBox[32.5mm]{趣味・特技}{\Hobbies}
  \vspace{6.8mm}\ResumeBox{自己 PR}{\SelfPR}
  \vspace{6.8mm}\ResumeBox[28.5mm]{本人希望記入欄}{\Request}}
